# App
NEXT_PUBLIC_APP_URL=https://gensite.tech
# Public support mailbox shown in the app (not a secret).
NEXT_PUBLIC_SUPPORT_EMAIL=admin@gensite.tech
NODE_ENV=development

# Support assistant (Dashboard -> Support). Platform-paid, so it runs on the
# cheapest live chat model unless pinned here (comma-separate a fallback order).
# SUPPORT_CHAT_MODEL=deepseek-v4-flash
# Questions per customer before the assistant asks them to wait.
# SUPPORT_CHAT_HOURLY_LIMIT=30
# SUPPORT_CHAT_DAILY_LIMIT=100

# Supabase
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Local Google OAuth (server-only; never use NEXT_PUBLIC_* for the secret).
# Supabase CLI reads these when its auth containers start; see AUTH_SETUP.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Database (for Drizzle migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Postgres connections held by the app process. 1 for serverless, ~10-20 on a VPS.
DB_POOL_MAX=10

# Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# AI Providers
ANTHROPIC_API_KEY=sk-ant-api03-...

# Local rules are the default: no model or external moderation call.
# Set remote explicitly to also enable the existing hosted moderation integration.
MODERATION_MODE=local
MODERATION_API_KEY=

# Image and video generation (see lib/safety/media-gate.ts and /acceptable-use).
# Every request, reference and result is screened by word rules plus a vision
# classifier on the platform's own channels, which fails closed.
MEDIA_GENERATION_ENABLED=false
# Video also needs ffmpeg (FFMPEG_PATH or on PATH) to screen frames.
MEDIA_VIDEO_ENABLED=false
FFMPEG_PATH=
# Safety classifier models, first that answers wins (public model ids).
MEDIA_SAFETY_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# Optional second opinion from OpenAI's free moderation endpoint (any tier).
# Read from MODERATION_API_KEY, OPENAI_AI_KEY or OPENAI_API_KEY.
OPENAI_AI_KEY=
# Refusals within the window that suspend media generation (minors: at once).
MEDIA_VIOLATION_THRESHOLD=3
MEDIA_VIOLATION_WINDOW_DAYS=30
# Generated files are deleted after this many days, and oldest-first once the
# bucket passes the budget (Supabase free plan: 1 GB of file storage).
MEDIA_RETENTION_DAYS=7
MEDIA_STORAGE_BUDGET_MB=800
# gensite-v1 render routing (comma-separated public model ids, best first).
GENSITE_IMAGE_MODELS=
GENSITE_VIDEO_MODELS=
# Flagged requests within 24h that trigger auto-suspension (default 5).
ABUSE_STRIKE_THRESHOLD=5

# Shared guardrails (apply the generation_guardrails SQL migration first).
GUARD_ACCOUNT_RPM=60
GUARD_IP_RPM=180
GUARD_CONCURRENCY=4
GUARD_VIOLATION_THRESHOLD=5
GUARD_COOLDOWN_SECONDS=3600
# Vercel uses its trusted IP header automatically. On other hosts only configure
# a header that your reverse proxy OVERWRITES and prevent direct origin access.
GUARD_TRUSTED_IP_HEADER=
# Optional dedicated HMAC secret; defaults to the server-only Supabase key.
GUARD_IP_HASH_KEY=

# Whop Billing
# Dashboard reference only; the application authenticates with WHOP_API_KEY.
# Get it from: https://whop.com/apps -> your app -> Settings
WHOP_APP_ID=whop_app_XXXXXXXXXXXX
# Company/account id (prefixed `biz_`) — required to create checkout
# configurations, which is how our user id reaches the webhook as metadata.
WHOP_ACCOUNT_ID=biz_w9or6ImVajOjNM
WHOP_API_KEY=your-whop-api-key-here
WHOP_WEBHOOK_SECRET=your-webhook-secret-here

# Whop Plan IDs (from your Whop dashboard)
WHOP_PLAN_STARTER=plan_XXXXXXXXXXXX
WHOP_PLAN_PRO=plan_XXXXXXXXXXXX
WHOP_PLAN_MAX=plan_XXXXXXXXXXXX
# Product for server-priced one-time credit purchases (not a plan ID).
WHOP_PRODUCT_CREDITS=prod_2XCm77DPpKsPC
# Stable server-only secret. Back up before issuing codes; changing it invalidates unused codes.
REDEMPTION_CODE_PEPPER=
# WHOP_PLAN_TOPUP is retired; new top-ups use WHOP_PRODUCT_CREDITS.

# Cron (reconciliation) auth
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your-cron-secret-here

# Relay.fast (see RELAY_INTEGRATION.md). RELAY_API_KEY (sk-...) makes the model
# calls. The access token and user id let the server read the account's selected
# sources every minute so Relay chat prices follow them; without both, Relay chat
# channels are withheld from routing rather than charged at a stale price.
RELAY_API_KEY=
RELAY_ACCESS_TOKEN=
RELAY_USER_ID=

# Admin alert email (lib/email/admin.ts): provider-failure alerts are emailed to
# ADMIN_ALERT_EMAIL (comma-separated) through this mailbox. Leave empty to keep
# alerts in the dashboard only. Test with scripts/send-test-admin-email.mts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_ALERT_EMAIL=

# Web search (lib/search/tavily.ts): the gateway's server-side `web_search` tool,
# used by gensite-v1, by Claude Code's WebSearch (Anthropic `web_search` server
# tool) and by Codex's hosted web_search, for any model. Each search is billed
# at $0.008 times the serving channel's markup. Leave empty to disable search.
TAVILY_API_KEY=

# gensite-v1 routing (lib/gensite/config.ts). Optional overrides:
# GENSITE_TIER_<FAST|BALANCED|CODER|MAX|VISION|LONG> = comma-separated public
# model ids, best first. GENSITE_EXCLUDED_PROVIDERS = `provider` or
# `provider:family` entries (default relay.fast:claude), or `none`.
# GENSITE_TIER_CODER=
# GENSITE_EXCLUDED_PROVIDERS=relay.fast:claude
# Difficulty classifier for prompts the gensite-v1 rules cannot place. Off by
# default: small models currently take 2-6 s for a one-word verdict.
# GENSITE_CLASSIFIER=on
# GENSITE_CLASSIFIER_MODEL=glm-5.3-flash
# GENSITE_CLASSIFIER_TIMEOUT_MS=3000
