# The installers are served byte for byte by /install.sh and /install.ps1.
# core.autocrlf would give the shell script CRLF endings on Windows checkouts,
# and `sh` cannot run those.
installers/*.sh text eol=lf
installers/*.ps1 text eol=crlf
# Windows host scripts run under Windows PowerShell 5.1.
hosting/windows/*.ps1 text eol=crlf
